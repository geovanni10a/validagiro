{
  "expo": {
    "name": "ValidaGiro",
    "slug": "validagiro",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o ValidaGiro use a câmera para ler códigos de barras.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite"
    ],
    "android": {
      "package": "com.geovanni10a.validagiro",
      "permissions": ["CAMERA"]
    },
    "ios": {
      "bundleIdentifier": "com.geovanni10a.validagiro",
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera é usada somente para ler códigos de barras."
      }
    }
  }
}
