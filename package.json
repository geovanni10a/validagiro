{
  "name": "validagiro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "pnpm contracts:generate && pnpm --filter @validagiro/contracts build && pnpm --filter @validagiro/api build",
    "dev": "pnpm --filter @validagiro/api dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @validagiro/api prisma:generate",
    "db:migrate": "pnpm --filter @validagiro/api prisma:migrate",
    "db:seed": "pnpm --filter @validagiro/api prisma:seed",
    "contracts:generate": "pnpm --filter @validagiro/contracts build && pnpm --filter @validagiro/api openapi:generate",
    "contracts:lint": "pnpm --filter @validagiro/api openapi:lint"
  }
}
