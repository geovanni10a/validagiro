# Copie para .env apenas no desenvolvimento local. Nunca versionar segredos reais.
POSTGRES_DB=validagiro
POSTGRES_USER=validagiro_owner
POSTGRES_PASSWORD=validagiro_local_only
POSTGRES_RUNTIME_PASSWORD=validagiro_runtime_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://validagiro_runtime:validagiro_runtime_local_only@localhost:5432/validagiro?schema=public
DIRECT_DATABASE_URL=postgresql://validagiro_owner:validagiro_local_only@localhost:5432/validagiro?schema=public
PORT=3000
NODE_ENV=development
DEV_AUTH_ENABLED=true
DEV_AUTH_SUBJECT=dev-user-geovanni
CORS_ORIGINS=http://localhost:3001
# Obrigatórios fora de development/test:
# JWT_ISSUER=https://seu-projeto.supabase.co/auth/v1
# JWT_AUDIENCE=authenticated
# JWT_JWKS_URI=https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json
