generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum MembershipRole {
  COMPANY_ADMIN
  STORE_MANAGER
  STOCK_OPERATOR
  VIEWER
}

enum BarcodeFormat {
  EAN_8
  EAN_13
  UPC_A
  UPC_E
  INTERNAL
}

enum UnitOfMeasure {
  UNIT
  KG
  G
  L
  ML
}

enum QuestionnaireStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum SubmissionStatus {
  PROCESSING
  COMPLETED
}

enum AnswerSection {
  PRODUCT
  BATCH
  META
}

enum BatchStatus {
  ACTIVE
  DEPLETED
  EXPIRED
  DISCARDED
}

enum MovementType {
  INTAKE
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  authSubject   String       @unique @map("auth_subject") @db.VarChar(255)
  displayName   String       @map("display_name") @db.VarChar(160)
  email         String?      @db.VarChar(320)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships   Membership[]
  submissions   IntakeSubmission[]
  movements     StockMovement[]
  auditEvents   AuditEvent[]
  @@map("users")
}

model Company {
  id          String       @id @default(uuid()) @db.Uuid
  legalName   String       @map("legal_name") @db.VarChar(200)
  displayName String       @map("display_name") @db.VarChar(160)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  stores      Store[]
  memberships Membership[]
  categories  Category[]
  products    Product[]
  barcodes    ProductBarcode[]
  locations   Location[]
  submissions IntakeSubmission[]
  answers     IntakeAnswer[]
  batches     Batch[]
  movements   StockMovement[]
  auditEvents AuditEvent[]
  @@map("companies")
}

model Store {
  id               String       @id @default(uuid()) @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  name             String       @db.VarChar(160)
  timezone         String       @db.VarChar(64)
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  company          Company      @relation(fields: [companyId], references: [id])
  membershipStores MembershipStore[]
  locations        Location[]
  submissions      IntakeSubmission[]
  batches          Batch[]
  movements        StockMovement[]
  auditEvents      AuditEvent[]
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("stores")
}

model Membership {
  id               String           @id @default(uuid()) @db.Uuid
  companyId        String           @map("company_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  role             MembershipRole
  allStores        Boolean          @default(false) @map("all_stores")
  status           RecordStatus     @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  company          Company          @relation(fields: [companyId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  stores           MembershipStore[]
  @@unique([companyId, userId])
  @@unique([id, companyId])
  @@index([userId, status])
  @@map("memberships")
}

model MembershipStore {
  membershipId String     @map("membership_id") @db.Uuid
  companyId    String     @map("company_id") @db.Uuid
  storeId      String     @map("store_id") @db.Uuid
  membership   Membership @relation(fields: [membershipId, companyId], references: [id, companyId])
  store        Store      @relation(fields: [storeId, companyId], references: [id, companyId])
  @@id([membershipId, storeId])
  @@index([storeId, companyId])
  @@map("membership_stores")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String   @db.VarChar(160)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  company   Company  @relation(fields: [companyId], references: [id])
  products  Product[]
  @@unique([id, companyId])
  @@index([companyId, active])
  @@map("categories")
}

model Product {
  id                           String        @id @default(uuid()) @db.Uuid
  companyId                    String        @map("company_id") @db.Uuid
  categoryId                   String        @map("category_id") @db.Uuid
  name                         String        @db.VarChar(160)
  brand                        String?       @db.VarChar(100)
  unitOfMeasure                UnitOfMeasure @map("unit_of_measure")
  packageContentValue          Decimal?      @map("package_content_value") @db.Decimal(18, 3)
  packageContentUnit           String?       @map("package_content_unit") @db.VarChar(16)
  salePrice                    Decimal       @map("sale_price") @db.Decimal(12, 2)
  currency                     String        @default("BRL") @db.Char(3)
  automaticPromotionEligible   Boolean       @default(false) @map("automatic_promotion_eligible")
  active                       Boolean       @default(true)
  version                      Int           @default(1)
  createdAt                    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  company                      Company       @relation(fields: [companyId], references: [id])
  category                     Category      @relation(fields: [categoryId, companyId], references: [id, companyId])
  barcodes                     ProductBarcode[]
  submissions                  IntakeSubmission[]
  batches                      Batch[]
  @@unique([id, companyId])
  @@index([companyId, active])
  @@map("products")
}

model ProductBarcode {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  productId      String        @map("product_id") @db.Uuid
  format         BarcodeFormat
  rawValue       String        @map("raw_value") @db.VarChar(64)
  canonicalValue String        @map("canonical_value") @db.VarChar(64)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  company        Company       @relation(fields: [companyId], references: [id])
  product        Product       @relation(fields: [productId, companyId], references: [id, companyId])
  @@unique([companyId, canonicalValue])
  @@index([companyId, productId, active])
  @@map("product_barcodes")
}

model QuestionnaireVersion {
  id             String              @id @default(uuid()) @db.Uuid
  code           String              @db.VarChar(64)
  version        Int
  schemaVersion  Int                 @map("schema_version")
  definition     Json
  checksum       String              @db.Char(64)
  status         QuestionnaireStatus @default(DRAFT)
  publishedAt    DateTime?           @map("published_at") @db.Timestamptz(6)
  supportedUntil DateTime?           @map("supported_until") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  submissions    IntakeSubmission[]
  @@unique([code, version])
  @@index([code, status, version])
  @@map("questionnaire_versions")
}

model Location {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  code        String   @db.VarChar(40)
  name        String   @db.VarChar(160)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  company     Company  @relation(fields: [companyId], references: [id])
  store       Store    @relation(fields: [storeId, companyId], references: [id, companyId])
  batches     Batch[]
  @@unique([companyId, storeId, code])
  @@unique([id, companyId, storeId])
  @@index([companyId, storeId, active])
  @@map("locations")
}

model IntakeSubmission {
  id                    String             @id @default(uuid()) @db.Uuid
  companyId             String             @map("company_id") @db.Uuid
  storeId               String             @map("store_id") @db.Uuid
  actorUserId           String             @map("actor_user_id") @db.Uuid
  questionnaireVersionId String            @map("questionnaire_version_id") @db.Uuid
  clientRequestId       String             @map("client_request_id") @db.Uuid
  requestHash           String             @map("request_hash") @db.Char(64)
  status                SubmissionStatus   @default(PROCESSING)
  deviceId              String             @map("device_id") @db.Uuid
  deviceAppVersion      String             @map("device_app_version") @db.VarChar(32)
  capturedAt            DateTime           @map("captured_at") @db.Timestamptz(6)
  receivedAt            DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  completedAt           DateTime?          @map("completed_at") @db.Timestamptz(6)
  productId             String?            @map("product_id") @db.Uuid
  batchId               String?            @unique @map("batch_id") @db.Uuid
  initialMovementId     String?            @unique @map("initial_movement_id") @db.Uuid
  responseSnapshot      Json?              @map("response_snapshot")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  company               Company            @relation(fields: [companyId], references: [id])
  store                 Store              @relation(fields: [storeId, companyId], references: [id, companyId])
  actor                 User               @relation(fields: [actorUserId], references: [id])
  questionnaireVersion  QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id])
  product               Product?           @relation(fields: [productId, companyId], references: [id, companyId])
  batch                 Batch?             @relation("SubmissionBatch", fields: [batchId, companyId, storeId], references: [id, companyId, storeId])
  initialMovement       StockMovement?     @relation("SubmissionInitialMovement", fields: [initialMovementId, companyId, storeId], references: [id, companyId, storeId])
  answers               IntakeAnswer[]
  movement              StockMovement?     @relation("MovementSubmission")
  @@unique([companyId, clientRequestId])
  @@unique([id, companyId])
  @@unique([id, companyId, storeId])
  @@unique([batchId, companyId, storeId])
  @@unique([initialMovementId, companyId, storeId])
  @@index([companyId, storeId, receivedAt(sort: Desc)])
  @@index([companyId, actorUserId, receivedAt(sort: Desc)])
  @@map("intake_submissions")
}

model IntakeAnswer {
  id           String         @id @default(uuid()) @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  questionKey  String         @map("question_key") @db.VarChar(100)
  section      AnswerSection
  value        Json
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  company      Company        @relation(fields: [companyId], references: [id])
  submission   IntakeSubmission @relation(fields: [submissionId, companyId], references: [id, companyId])
  @@unique([submissionId, questionKey])
  @@index([companyId, submissionId])
  @@map("intake_answers")
}

model Batch {
  id                    String        @id @default(uuid()) @db.Uuid
  companyId             String        @map("company_id") @db.Uuid
  storeId               String        @map("store_id") @db.Uuid
  productId             String        @map("product_id") @db.Uuid
  locationId            String        @map("location_id") @db.Uuid
  batchNumber           String?       @map("batch_number") @db.VarChar(80)
  normalizedBatchNumber String?       @map("normalized_batch_number") @db.VarChar(80)
  expiryDate            DateTime      @map("expiry_date") @db.Date
  entryDate             DateTime      @map("entry_date") @db.Date
  receivedQuantity      Decimal       @map("received_quantity") @db.Decimal(18, 3)
  currentQuantity       Decimal       @map("current_quantity") @db.Decimal(18, 3)
  unitCost              Decimal?      @map("unit_cost") @db.Decimal(12, 2)
  currency              String?       @db.Char(3)
  observation           String?       @db.VarChar(500)
  status                BatchStatus   @default(ACTIVE)
  version               Int           @default(1)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  company               Company       @relation(fields: [companyId], references: [id])
  store                 Store         @relation(fields: [storeId, companyId], references: [id, companyId])
  product               Product       @relation(fields: [productId, companyId], references: [id, companyId])
  location              Location      @relation(fields: [locationId, companyId, storeId], references: [id, companyId, storeId])
  submission            IntakeSubmission? @relation("SubmissionBatch")
  movements             StockMovement[]
  @@unique([id, companyId, storeId])
  @@index([companyId, storeId, expiryDate, status])
  @@index([companyId, storeId, productId, expiryDate])
  @@index([companyId, storeId, locationId, status])
  @@map("batches")
}

model StockMovement {
  id             String       @id @default(uuid()) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  storeId        String       @map("store_id") @db.Uuid
  batchId        String       @map("batch_id") @db.Uuid
  type           MovementType
  quantityDelta  Decimal      @map("quantity_delta") @db.Decimal(18, 3)
  balanceAfter   Decimal      @map("balance_after") @db.Decimal(18, 3)
  submissionId   String       @unique @map("submission_id") @db.Uuid
  actorUserId    String       @map("actor_user_id") @db.Uuid
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  reason         String?      @db.VarChar(300)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  company        Company      @relation(fields: [companyId], references: [id])
  store          Store        @relation(fields: [storeId, companyId], references: [id, companyId])
  batch          Batch        @relation(fields: [batchId, companyId, storeId], references: [id, companyId, storeId])
  submission     IntakeSubmission @relation("MovementSubmission", fields: [submissionId, companyId, storeId], references: [id, companyId, storeId])
  initialFor     IntakeSubmission? @relation("SubmissionInitialMovement")
  actor          User         @relation(fields: [actorUserId], references: [id])
  @@unique([id, companyId, storeId])
  @@unique([submissionId, companyId, storeId])
  @@index([companyId, storeId, batchId, occurredAt])
  @@map("stock_movements")
}

model AuditEvent {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  storeId         String?  @map("store_id") @db.Uuid
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  action          String   @db.VarChar(80)
  entityType      String   @map("entity_type") @db.VarChar(80)
  entityId        String   @map("entity_id") @db.Uuid
  before          Json?
  after           Json?
  clientRequestId String?  @map("client_request_id") @db.Uuid
  correlationId   String   @map("correlation_id") @db.Uuid
  ipHash          String?  @map("ip_hash") @db.VarChar(128)
  userAgent       String?  @map("user_agent") @db.VarChar(300)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  company         Company  @relation(fields: [companyId], references: [id])
  store           Store?   @relation(fields: [storeId, companyId], references: [id, companyId])
  actor           User?    @relation(fields: [actorUserId], references: [id])
  @@index([companyId, entityType, entityId, createdAt(sort: Desc)])
  @@index([companyId, clientRequestId])
  @@map("audit_events")
}
